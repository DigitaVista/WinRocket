{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "primary", "name": "Primary", "color": "#0a84c9" },
				{ "slug": "primary-dark", "name": "Primary dark", "color": "#076aa3" },
				{ "slug": "navy", "name": "Navy", "color": "#0f1b2d" },
				{ "slug": "navy-light", "name": "Navy light", "color": "#1a2a42" },
				{ "slug": "ink", "name": "Ink", "color": "#111827" },
				{ "slug": "muted", "name": "Muted", "color": "#64748b" },
				{ "slug": "surface", "name": "Surface", "color": "#f3f5f8" },
				{ "slug": "border", "name": "Border", "color": "#e3e7ee" },
				{ "slug": "white", "name": "White", "color": "#ffffff" },
				{ "slug": "live", "name": "Live", "color": "#22c55e" },
				{ "slug": "future", "name": "Future", "color": "#f59e0b" },
				{ "slug": "accent", "name": "Accent", "color": "#6d5ce7" }
			]
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1320px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "2XS", "size": "8px" },
				{ "slug": "30", "name": "XS", "size": "12px" },
				{ "slug": "40", "name": "S", "size": "16px" },
				{ "slug": "50", "name": "M", "size": "24px" },
				{ "slug": "60", "name": "L", "size": "40px" },
				{ "slug": "70", "name": "XL", "size": "64px" },
				{ "slug": "80", "name": "2XL", "size": "96px" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Archivo",
					"fontFamily": "Archivo, 'Arial Black', system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "500 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/archivo-variable.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-variable.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "XS", "size": "12px", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "14px", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "16px", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "20px", "fluid": { "min": "18px", "max": "20px" } },
				{ "slug": "x-large", "name": "XL", "size": "28px", "fluid": { "min": "22px", "max": "28px" } },
				{ "slug": "xx-large", "name": "2XL", "size": "40px", "fluid": { "min": "28px", "max": "40px" } },
				{ "slug": "huge", "name": "Huge", "size": "64px", "fluid": { "min": "36px", "max": "64px" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--surface)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "24px",
			"padding": { "left": "20px", "right": "20px" }
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--primary-dark)" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "800",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				},
				"color": { "text": "var(--wp--preset--color--navy)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "4px" },
				"spacing": { "padding": { "top": "12px", "bottom": "12px", "left": "22px", "right": "22px" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "13px",
					"fontWeight": "800",
					"letterSpacing": "0.04em",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": { "background": "var(--wp--preset--color--primary-dark)", "text": "var(--wp--preset--color--white)" }
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "800",
					"fontSize": "24px",
					"letterSpacing": "-0.02em"
				},
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--navy)" } } }
			},
			"core/site-tagline": {
				"typography": { "fontSize": "12px" },
				"color": { "text": "var(--wp--preset--color--muted)" }
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "13px",
					"fontWeight": "800",
					"letterSpacing": "0.04em",
					"textTransform": "uppercase"
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Page (wide, no title)", "postTypes": [ "page" ] }
	]
}
